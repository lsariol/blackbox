# Local development only: copy to .env, which compose reads for the ${...} values.

# Postgres, as the containers reach it; scripts/db/setup.sql creates the roles.
BLACKBOX_DATABASE_URL=postgres://blackbox_app:CHANGE_ME@host.docker.internal:5432/blackbox_db
BLACKBOX_DATABASE_MIGRATOR_URL=postgres://blackbox_migrator:CHANGE_ME@host.docker.internal:5432/blackbox_db
BLACKBOX_DATABASE_READER_URL=postgres://blackbox_reader:CHANGE_ME@host.docker.internal:5432/blackbox_db

# One API token per consumer, 32 or more random characters each (openssl rand -hex 32).
BLACKBOX_CLI_TOKEN=
SHARED_BLACKBOX_VISTA_TOKEN=

# The time zone the CLI shows times in.
TZ=America/Toronto
